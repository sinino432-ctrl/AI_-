import os
import time
import urllib.request
import cv2
import mediapipe as mp
from mediapipe.tasks import python
from mediapipe.tasks.python import vision

MODEL_DIR = "models"
MODELS = {
    "face": (
        "blaze_face_short_range.tflite",
        "https://storage.googleapis.com/mediapipe-models/face_detector/blaze_face_short_range/float16/1/blaze_face_short_range.tflite",
    ),
    "hand": (
        "hand_landmarker.task",
        "https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task",
    ),
    "pose": (
        "pose_landmarker_lite.task",
        "https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/1/pose_landmarker_lite.task",
    ),
}

# BGR 색상 정의 (OpenCV 기준)
COLOR_FACE_BOX = (0, 255, 255)    # 노랑: 얼굴 박스
COLOR_FACE_KP = (0, 200, 255)     # 주황노랑: 얼굴 키포인트

FINGER_CHAINS = {
    "thumb":  ([0, 1, 2, 3, 4],     (0, 165, 255)),  # 주황: 엄지
    "index":  ([0, 5, 6, 7, 8],     (0, 255, 0)),    # 초록: 검지
    "middle": ([0, 9, 10, 11, 12],  (255, 0, 255)),  # 마젠타: 중지
    "ring":   ([0, 13, 14, 15, 16], (255, 255, 0)),  # 시안: 약지
    "pinky":  ([0, 17, 18, 19, 20], (0, 255, 200)),  # 연두: 소지
}

POSE_SEGMENTS = [
    # 상체·어깨·몸통 (파랑/청록 계열)
    ((11, 12), (255, 180, 0)),
    ((11, 23), (255, 120, 0)),
    ((12, 24), (255, 120, 0)),
    ((23, 24), (255, 90, 0)),
    # 왼팔·오른팔 (초록/라임 계열)
    ((11, 13), (80, 255, 80)),
    ((13, 15), (40, 220, 40)),
    ((12, 14), (120, 255, 160)),
    ((14, 16), (80, 220, 120)),
    # 왼다리·오른다리 (빨강/코랄 계열)
    ((23, 25), (80, 80, 255)),
    ((25, 27), (40, 40, 230)),
    ((24, 26), (140, 100, 255)),
    ((26, 28), (110, 60, 230)),
]


def ensure_models() -> dict[str, str]:
    os.makedirs(MODEL_DIR, exist_ok=True)
    paths = {}
    for key, (filename, url) in MODELS.items():
        local_path = os.path.join(MODEL_DIR, filename)
        if not os.path.exists(local_path):
            print(f"모델 다운로드 중: {filename}")
            urllib.request.urlretrieve(url, local_path)
        paths[key] = local_path
    return paths


def to_px(lm, w: int, h: int) -> tuple[int, int]:
    return int(lm.x * w), int(lm.y * h)


def draw_faces(frame, detection_result, w: int, h: int):
    if not detection_result or not detection_result.detections:
        return
    for det in detection_result.detections:
        bbox = det.bounding_box
        x1 = max(0, int(bbox.origin_x))
        y1 = max(0, int(bbox.origin_y))
        x2 = min(w - 1, int(bbox.origin_x + bbox.width))
        y2 = min(h - 1, int(bbox.origin_y + bbox.height))

        cv2.rectangle(frame, (x1, y1), (x2, y2), COLOR_FACE_BOX, 2)
        cv2.putText(
            frame, "FACE", (x1, max(20, y1 - 8)),
            cv2.FONT_HERSHEY_SIMPLEX, 0.6, COLOR_FACE_BOX, 2
        )
        for kp in det.keypoints:
            px, py = int(kp.x * w), int(kp.y * h)
            cv2.circle(frame, (px, py), 4, COLOR_FACE_KP, -1)


def draw_hands(frame, hand_result, w: int, h: int):
    if not hand_result or not hand_result.hand_landmarks:
        return
    for hand_lms in hand_result.hand_landmarks:
        pts = {idx: to_px(lm, w, h) for idx, lm in enumerate(hand_lms)}
        for _, (indices, color) in FINGER_CHAINS.items():
            for i in range(len(indices) - 1):
                p1 = pts[indices[i]]
                p2 = pts[indices[i + 1]]
                cv2.line(frame, p1, p2, color, 3)
            for idx in indices:
                radius = 6 if idx in (4, 8, 12, 16, 20) else 4
                cv2.circle(frame, pts[idx], radius, color, -1)


def draw_pose(frame, pose_result, w: int, h: int):
    if not pose_result or not pose_result.pose_landmarks:
        return
    for pose_lms in pose_result.pose_landmarks:
        pts = {idx: to_px(lm, w, h) for idx, lm in enumerate(pose_lms)}
        for (a, b), color in POSE_SEGMENTS:
            if a in pts and b in pts:
                cv2.line(frame, pts[a], pts[b], color, 3)
        for idx, pt in pts.items():
            if 11 <= idx <= 28:
                cv2.circle(frame, pt, 5, (255, 255, 255), -1)
                cv2.circle(frame, pt, 5, (40, 40, 40), 1)


def main():
    model_paths = ensure_models()

    face_detector = vision.FaceDetector.create_from_options(
        vision.FaceDetectorOptions(
            base_options=python.BaseOptions(model_asset_path=model_paths["face"]),
            running_mode=vision.RunningMode.VIDEO,
            min_detection_confidence=0.5,
        )
    )
    hand_landmarker = vision.HandLandmarker.create_from_options(
        vision.HandLandmarkerOptions(
            base_options=python.BaseOptions(model_asset_path=model_paths["hand"]),
            running_mode=vision.RunningMode.VIDEO,
            num_hands=2,
            min_hand_detection_confidence=0.5,
            min_tracking_confidence=0.5,
        )
    )
    pose_landmarker = vision.PoseLandmarker.create_from_options(
        vision.PoseLandmarkerOptions(
            base_options=python.BaseOptions(model_asset_path=model_paths["pose"]),
            running_mode=vision.RunningMode.VIDEO,
            num_poses=1,
            min_pose_detection_confidence=0.5,
            min_tracking_confidence=0.5,
        )
    )

    cap = cv2.VideoCapture(0)
    if not cap.isOpened():
        raise RuntimeError("웹캠을 열 수 없습니다. 카메라 연결이나 인덱스(0, 1)를 확인하세요.")

    start_time = time.time()
    last_timestamp_ms = -1

    try:
        while True:
            ret, frame = cap.read()
            if not ret:
                break

            frame = cv2.flip(frame, 1)
            h, w, _ = frame.shape
            rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb)

            timestamp_ms = int((time.time() - start_time) * 1000)
            if timestamp_ms <= last_timestamp_ms:
                timestamp_ms = last_timestamp_ms + 1
            last_timestamp_ms = timestamp_ms

            face_res = face_detector.detect_for_video(mp_image, timestamp_ms)
            hand_res = hand_landmarker.detect_for_video(mp_image, timestamp_ms)
            pose_res = pose_landmarker.detect_for_video(mp_image, timestamp_ms)

            draw_pose(frame, pose_res, w, h)
            draw_hands(frame, hand_res, w, h)
            draw_faces(frame, face_res, w, h)

            cv2.imshow("Webcam Face + Fingers + Pose (Press ESC or Q to quit)", frame)
            key = cv2.waitKey(1) & 0xFF
            if key in (27, ord("q")):
                break
    finally:
        cap.release()
        cv2.destroyAllWindows()
        face_detector.close()
        hand_landmarker.close()
        pose_landmarker.close()


if __name__ == "__main__":
    main()
